  "known_issues": {
    "table5_5_random_arm_seed_bug": {
      "status": "FIXED and re-verified: after adding the missing selection_offset term, this reproduction matches published per-seed random flip_rate/m2b to 6 decimal places (13:0.073638, 42:0.062618, 77:0.058207, 123:0.060402, 2024:0.067708; overall 0.064515/0.027865, identical to trial_results.csv).",
      "root_cause": "step3_hashed_import_intervention.py's random-trial seed formula omits the selection_offset term (+10_000_000 for selection_type=='random') present in DCSA's original intervention_seed(). This draws a different, still-valid, but non-matching set of random feature indices.",
      "affected": [
        "step3 random-arm numbers (both B and C, since both share this same buggy call)"
      ],
      "not_affected": [
        "step3 important-arm numbers (B=0.3106, C=0.2345) -- no RNG involved, deterministic top-k selection",
        "step2 (Figure 5-3/5-4) random-arm numbers -- independently re-verified against raw trial_results.csv per seed, exact match to 10 decimal places"
      ]
    },
    "original_baseline_auc_extraction_error": {
      "status": "identified and corrected",
      "root_cause": "aggregate_results.csv's auc_original column reflects only the LAST seed (2024) due to a dict-overwrite in DCSA's own aggregate_trial_rows() (baseline_by_context keyed by (feature_group, test_week) only, not seed). Averaging this column across weeks does NOT give a genuine 5-seed average baseline AUC.",
      "fix": "Use raw trial_results.csv, grouped by (feature_group, seed), as ground truth A for baseline AUC. See part1_baseline_auc_CORRECTED above."
    }
  }
